### Secret stash component. Stuff like potted plants, comfy chair cushions, etc...

comp-secret-stash-action-hide-success = Вы прячете { $item }. Тайник: {$stashname}.
comp-secret-stash-action-hide-container-not-empty = Здесь уже что-то есть!?
comp-secret-stash-action-hide-item-too-big = { CAPITALIZE($item) } слишком велик для тайника «{$stashname}».
comp-secret-stash-action-get-item-found-something = В тайнике «{$stashname}» что-то было!
comp-secret-stash-on-examine-found-hidden-item = В тайнике «{$stashname}» что-то спрятано!
comp-secret-stash-on-destroyed-popup = Из тайника «{$stashname}» что-то выпадает!

### Verbs
comp-secret-stash-verb-insert-into-stash = Спрятать предмет
comp-secret-stash-verb-insert-message-item-already-inside = В тайнике «{$stashname}» уже есть предмет.
comp-secret-stash-verb-insert-message-no-item = Спрятать { $item } в тайник «{$stashname}».
comp-secret-stash-verb-take-out-item = Достать предмет
comp-secret-stash-verb-take-out-message-something = Извлечь содержимое тайника «{$stashname}».
comp-secret-stash-verb-take-out-message-nothing = В тайнике «{$stashname}» ничего нет.

comp-secret-stash-verb-close = Закрыть
comp-secret-stash-verb-cant-close = Так тайник «{$stashname}» не закрыть.
comp-secret-stash-verb-open = Открыть

### Stash names
secret-stash-plant = растение
secret-stash-toilet = сливной бачок
secret-stash-plushie = плюшевая игрушка
secret-stash-cake = торт
