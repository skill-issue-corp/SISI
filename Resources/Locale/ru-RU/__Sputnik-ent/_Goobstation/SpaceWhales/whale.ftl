    .desc = { "" }

ent-LeviathanGrapplingGun = крюк левиафанщика
    .desc = Модифицированный крюк-кошка, используемый старшими специалистами по утилизации для верховой езды на молодых космических китах. Чтобы использовать, прикрепите его прямо к голове кита и управляйте им влево и вправо. Остерегайтесь: кит может уйти в гиперпространство, если подвести его слишком близко к станции.

ent-MaterialLeviathanScale = чешуйчатые пластины левиафана
    .desc = Осколки, сброшенные космическим левиафаном, исключительно редки. Их ценят утилизаторы, а также мегакорпорации — для предметов роскоши, сшитых из останков вымирающей звёздной жизни.
    .suffix = Целая

