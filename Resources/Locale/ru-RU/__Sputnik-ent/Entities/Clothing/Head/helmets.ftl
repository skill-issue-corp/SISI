ent-ClothingHeadHelmetBase = { ent-ClothingHeadBase }
    .desc = { ent-ClothingHeadBase.desc }

ent-ClothingHeadHelmetArmoredBase = { ent-ClothingHeadHelmetBase }
    .desc = { ent-ClothingHeadHelmetBase.desc }

ent-ClothingHeadHelmetBasic = шлем
    .desc = Стандартное снаряжение службы безопасности. Защищает голову от ударов.

ent-ClothingHeadHelmetMerc = шлем наёмника
    .desc = Прочный и лёгкий боевой шлем, популярный среди наёмников. Пахнет порохом и джунглями.

ent-ClothingHeadHelmetSwat = шлем спецназа
    .desc = Чрезвычайно надёжный шлем, популярный у военизированных отрядов. Сверху красуется логотип NanoTrasen.

ent-ClothingHeadHelmetSwatSyndicate = шлем спецназа
    .desc = Чрезвычайно надёжный шлем, популярный у военизированных отрядов. Украшен зловещим узором из красных и чёрных полос.
    .suffix = Синдикат

ent-ClothingHeadHelmetRiot = лёгкий противоударный шлем
    .desc = Шлем, специально созданный для защиты от атак в ближнем бою.

ent-ClothingHeadHelmetBombSuit = шлем взрывозащитного костюма
    .desc = Тяжёлый шлем для защиты от ударной волны и осколков при взрыве бомбы.

ent-ClothingHeadHelmetJanitorBombSuit = шлем взрывозащитного костюма уборщика
    .desc = Тяжёлый шлем, рассчитанный на взрывы, возникающие при химических реакциях.

ent-ClothingHeadHelmetCult = шлем культиста
    .desc = Надёжный шлем культиста со зловещим видом.

ent-ClothingHeadHelmetSpaceNinja = шлем космического ниндзя
    .desc = На вид это простая чёрная ткань, а на деле - высокотехнологичный шлем из наноткани. Стандартное снаряжение ниндзя.

ent-ClothingHeadHelmetTemplar = рыцарский шлем
    .desc = Декоративный шлем, сделанный по образцу шлемов рыцарей былых времён.

ent-ClothingHeadHelmetThunderdome = шлем громового купола
    .desc = Да начнётся битва!

ent-ClothingHeadHelmetWizardHelm = шлем волшебника
    .desc = Странный на вид шлем, который уж точно принадлежит настоящему магу. За шляпу волшебника не считается.

ent-ClothingHeadHelmetFire = пожарный шлем
    .desc = Лучший друг атмосферного техника. Немного защищает от жара и классно выглядит.

ent-ClothingHeadHelmetAtmosFire = атмосферный пожарный шлем
    .desc = Пожарный шлем атмоса, в котором не станет жарко ни при каких обстоятельствах.

ent-ClothingHeadHelmetLing = хитиновый шлем
    .desc = Всепоглощающая масса хитиновой брони.

ent-ClothingHeadHelmetERTLeader = шлем командира ОБР
    .desc = Шлем для работы в атмосфере, который носит командир Отряда Быстрого Реагирования NanoTrasen. С синими вставками.

ent-ClothingHeadHelmetERTSecurity = шлем бойца ОБР
    .desc = Шлем для работы в атмосфере, который носят бойцы Отряда Быстрого Реагирования NanoTrasen. С красными вставками.

ent-ClothingHeadHelmetERTMedic = шлем медика ОБР
    .desc = Шлем для работы в атмосфере, который носят медики Отряда Быстрого Реагирования NanoTrasen. С белыми вставками.

ent-ClothingHeadHelmetERTEngineer = шлем инженера ОБР
    .desc = Шлем для работы в атмосфере, который носят инженеры Отряда Быстрого Реагирования NanoTrasen. С оранжевыми вставками и защитой для глаз.

ent-ClothingHeadHelmetERTJanitor = шлем уборщика ОБР
    .desc = Шлем для работы в атмосфере, который носят уборщики Отряда Быстрого Реагирования NanoTrasen. С тёмно-фиолетовыми вставками.

ent-ClothingHeadHelmetRaid = шлем рейдового костюма синдиката
    .desc = Бронированный шлем к рейдовому костюму синдиката. Очень стильный.

ent-ClothingHeadHelmetBone = костяной шлем
    .desc = Классный шлем из черепов ваших врагов.

ent-ClothingHeadHelmetPodWars = шлем броненосца II
    .desc = Шлем броненосца II, пережиток войн на капсулах.

ent-ClothingHeadHelmetJustice = шлем правосудия
    .desc = Передовое снаряжение службы безопасности. Защищает станцию от негодяев.

ent-ClothingHeadHelmetJusticeEmpty = { ent-ClothingHeadHelmetJustice }
    .desc = { ent-ClothingHeadHelmetJustice.desc }
    .suffix = Пусто

ent-ActionToggleJusticeHelm = Переключить Шлем Правосудия
    .desc = Включает или выключает шлем правосудия.

ent-CardHelmet = картонный шлем
    .desc = Средневековый шлем из картона.