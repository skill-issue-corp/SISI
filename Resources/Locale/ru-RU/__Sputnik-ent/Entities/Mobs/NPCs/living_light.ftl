ent-MobLivingLight = светящийся человек
    .desc = Ослепительная фигура из чистого света, на вид бесплотная.

ent-MobLuminousPerson = { ent-MobLivingLight }
    .desc = { ent-MobLivingLight.desc }

ent-MobLuminousObject = светящийся предмет
    .desc = Небольшой светящийся предмет, сияние которого оставляет ожоги на коже.

ent-MobLuminousEntity = светящееся существо
    .desc = Ослепительное полупрозрачное существо. Его яркий глаз кажется опасным и обжигающим.

ent-MobLuminousPersonSalvage = { ent-MobLuminousPerson }
    .desc = { ent-MobLuminousPerson.desc }
    .suffix = Правила Утилизации

ent-MobLuminousObjectSalvage = { ent-MobLuminousObject }
    .desc = { ent-MobLuminousObject.desc }
    .suffix = Правила Утилизации

ent-MobLuminousEntitySalvage = { ent-MobLuminousEntity }
    .desc = { ent-MobLuminousEntity.desc }
    .suffix = Правила Утилизации