ent-BaseMeleeWeaponEnergy = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }

ent-EnergySword = энергетический меч
    .desc = Очень громкий и опасный меч с лезвием из чистой концентрированной плазмы. Разрезает небронированные цели как масло.

ent-EnergyDaggerLoud = энергетический кинжал
    .desc = Не такой громкий и опасный кинжал с лезвием из чистой концентрированной плазмы. Этот совершенно не замаскирован.

ent-EnergyDagger = ручка
    .desc = Ручка с чёрными чернилами.
    .suffix = Э-кинжал

ent-EnergyDaggerBox = коробка с энергокинжалом
    .desc = Небольшая коробка, содержащая э-кинжал. Упаковка распадается при открытии, не оставляя улик.
    .suffix = Э-кинжал

ent-EnergyCutlass = энергетическая сабля
    .desc = Экзотическое энергетическое оружие.

ent-EnergySwordDoubleBase = двухклинковый энергетический меч
    .desc = Стажёры командования Синдиката решили, что одного лезвия на энергетическом мече недостаточно. Можно хранить в карманах.

ent-EnergySwordDouble = { ent-EnergySwordDoubleBase }
    .desc = { ent-EnergySwordDoubleBase.desc }

ent-CyborgEnergySword = { ent-EnergySword }
    .desc = Очень громкий и опасный меч с лезвием из чистой концентрированной плазмы. Специально разработан для киборгов Синдиката.
    .suffix = Для боргов

ent-CyborgEnergySwordDouble = { ent-EnergySwordDoubleBase }
    .desc = Стажёры командования Синдиката решили, что одного лезвия на энергетическом мече недостаточно. Специально разработан для киборгов Синдиката.
    .suffix = Одноручный, для боргов

ent-EnergyDaggerLoudBlue = { ent-EnergyDaggerLoud }
    .desc = { ent-EnergyDaggerLoud.desc }
    .suffix = синий
