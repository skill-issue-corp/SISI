ent-BaseCartridgePistol = патрон (.35 авто)
    .desc = { ent-BaseCartridge.desc }

ent-CartridgePistol = патрон (.35 авто)
    .desc = Пожалуй, самый распространённый калибр на рынке. Подходит для всевозможных пистолетов и пистолетов-пулемётов. Обычные кинетические патроны широко распространены и пригодны в большинстве ситуаций.

ent-CartridgePistolPractice = патрон (.35 авто учебные)
    .desc = Пожалуй, самый распространённый калибр на рынке. Подходит для всевозможных пистолетов и пистолетов-пулемётов. Учебный патрон стреляет меловой пулей, которая жалит, но не причиняет серьёзного вреда.

ent-CartridgePistolIncendiary = патрон (.35 авто зажигательные)
    .desc = Пожалуй, самый распространённый калибр на рынке. Подходит для всевозможных пистолетов и пистолетов-пулемётов. Зажигательные боеприпасы содержат самовоспламеняющийся состав, поджигающий цель.

ent-CartridgePistolUranium = патрон (.35 авто урановые)
    .desc = Пожалуй, самый распространённый калибр на рынке. Подходит для всевозможных пистолетов и пистолетов-пулемётов. В урановых патронах свинцовый сердечник пули заменён делящимся материалом, который облучает цель изнутри.

ent-CartridgePistolSpent = патрон (.35 авто)
    .desc = { ent-BaseCartridgePistol.desc }
    .suffix = израсходовано