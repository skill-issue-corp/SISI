ent-BaseHoloParasite = { ent-MobGuardianBase }
    .desc = { ent-MobGuardianBase.desc }

ent-HoloParasiteStandard = Holoparasite Anchor
    .desc = A well-balanced hard-light defender, keyed to its owner's life to sustain itself.

ent-HoloParasiteAssassin = Holoparasite Wraith
    .desc = A shadowy, toxin-laced apparition that slips between the cracks of your enemies' awareness.

ent-HoloParasiteCharger = Holoparasite Dart
    .desc = A blisteringly fast presence that barrages across the battlefield and bowls over anything in its path.

ent-HoloParasiteBrawler = Holoparasite Torch
    .desc = A searing manifestation of raw fury whose every blow leaves its victims ablaze.

ent-HoloParasiteIcicle = Holoparasite Drift
    .desc = A frost-warded presence of living shards that leeches strength with each biting strike.

ent-HoloParasiteProtector = Holoparasite Aegis
    .desc = A ponderous bulwark of hard-light that anchors itself to its owner and soaks up harm.