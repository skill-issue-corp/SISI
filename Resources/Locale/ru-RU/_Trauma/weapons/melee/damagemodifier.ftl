click-damage-modifier = Лёгкие атаки (левая кнопка мыши) { $arg ->
        [1] [color=green]на {$abs}% сильнее.[/color]
        *[other] [color=red]на {$abs}% слабее.[/color]
    }

heavy-damage-modifier = Тяжёлые атаки (правая кнопка мыши) { $arg ->
        [1] [color=green]на {$abs}% сильнее.[/color]
        *[other] [color=red]на {$abs}% слабее.[/color]
    }
