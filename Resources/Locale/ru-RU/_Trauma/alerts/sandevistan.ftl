alerts-sandevistan-load-name = [color=cyan]Нагрузка Импланта[/color]
alerts-sandevistan-load-desc = Текущий уровень нагрузки на ваш имплант сандевистан. Чем выше значение, тем сильнее нагрузка на организм.
    При [color=yellow]{ SANDE_THRESHOLD("warning") }[/color] начнут появляться предупреждения.
    При [color=orange]{ SANDE_THRESHOLD("shaking") }[/color] вас начнёт неудержимо трясти.
    При [color=red]{ SANDE_THRESHOLD("damage") }[/color] вы начнёте получать физический урон.
    При [color=darkred]{ SANDE_THRESHOLD("disable") }[/color] имплант принудительно отключится.
