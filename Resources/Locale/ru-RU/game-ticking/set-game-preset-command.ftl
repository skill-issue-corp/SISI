set-game-preset-command-description = Назначает игровой режим на указанное число следующих раундов. Можно показать в лобби название и описание другого режима, чтобы запутать игроков.
set-game-preset-command-help-text = setgamepreset <id> [число раундов, по умолчанию 1] [ложный режим]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [число раундов]
set-game-preset-command-hint-3 = [ложный режим]

set-game-preset-optional-argument-not-integer = Если указан аргумент 2, он должен быть числом.
set-game-preset-preset-error = Не удалось найти игровой режим «{$preset}»
set-game-preset-decoy-error = Если указан аргумент 3, он должен задавать существующий режим. Не удалось найти игровой режим «{$preset}»

#set-game-preset-preset-set = Set game preset to "{$preset}"
set-game-preset-preset-set-finite = Назначен игровой режим «{$preset}» на следующие раунды ({$rounds}).
set-game-preset-preset-set-finite-with-decoy = Назначен игровой режим «{$preset}» на следующие раунды ({$rounds}). В лобби отображается {$decoy}.
