cmd-announce-desc = Отправляет внутриигровое объявление с указанным цветом и звуком.
cmd-announce-help = {$command} <сообщение> [отправитель] [цвет] [звук] - отправляет объявление. Отправитель по умолчанию - ЦК, цвет - Золотой, звук - announce.ogg. Цвет нужно указывать в формате #RRGGBB.

# The default sender for the announcement
cmd-announce-sender = Центральное Командование

# Completion hints
cmd-announce-arg-message = <сообщение>
cmd-announce-arg-sender = [отправитель]
cmd-announce-arg-color = [цвет]
cmd-announce-arg-sound = [звук]
