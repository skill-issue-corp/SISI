ntr-executive-tier-1-name = Станция
ntr-executive-tier-2-name = Отряды реагирования
ntr-executive-tier-3-name = Личное
ntr-executive-tier-4-name = Злодейское
ntr-executive-tier-5-name = Редкие платы машин
