movement-impaired-trait-examined = [color=yellow]{ CAPITALIZE(SUBJECT($target)) } слегка хромает. Похоже, { SUBJECT($target) } с трудом передвигается без посторонней помощи[/color]

trait-social-anxiety-name = Социофобия
